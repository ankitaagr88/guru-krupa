# Nightly backup at 02:30 server time (clinic is closed).
# Install: sudo cp deploy/gurukrupa-backup.service deploy/gurukrupa-backup.timer /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now gurukrupa-backup.timer
# Check:   systemctl list-timers gurukrupa-backup.timer
[Unit]
Description=Run Gurukrupa backup nightly

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
