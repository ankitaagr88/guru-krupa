# ---- WhatsApp (Meta Cloud API) ----
# Permanent System User token from Meta Business Manager (WhatsApp > API setup).
META_TOKEN=EAAB...your-permanent-token
# The "Phone number ID" shown in Meta > WhatsApp > API setup (NOT the phone number itself).
META_PHONE_NUMBER_ID=123456789012345
# Any secret string you choose; paste the same string in Meta's webhook "Verify token" box.
WEBHOOK_VERIFY_TOKEN=change-me-to-a-long-random-string
# Graph API version (optional)
META_API_VERSION=v20.0

# ---- Local storage (sessions, pending records, audit log) ----
DATABASE_URL=sqlite:///./data/intake.db

# ---- Destination: Gurukrupa clinic system ----
GURUKRUPA_API_URL=http://localhost:8000/api
GURUKRUPA_API_USER=whatsapp-bot
GURUKRUPA_API_PASSWORD=change-me

# ---- Destination: Google Sheet (Apps Script web app "Deploy > Web app" URL) ----
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# ---- Server ----
# Public base URL of this service (used only for printing the webhook URL in logs / README)
PUBLIC_BASE_URL=https://intake.example.com
